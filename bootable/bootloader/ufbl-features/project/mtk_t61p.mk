LOCAL_DIR := $(GET_LOCAL_DIR)
# List of features for this product
#FEATURE_FASTBOOT_EXTENSIONS := true
FEATURE_IDME := true

FEATURE_LIBTOMCRYPT := false
FEATURE_LIBTOMMATH := false
#FEATURE_LIFE_CYCLE_REASONS := true
FEATURE_LK_RAMDUMP := false

FEATURE_UNLOCK := true
FEATURE_SECURE_FLASHING  := false
FEATURE_SECURE_BOOT := false
FEATURE_ONETIME_UNLOCK := false

# fastboot oem flags feature
FEATURE_FOS_FLAGS := true

# common for MTK T61P platform
UFBL_PLAT_MTK_T61P := yes
export UFBL_PLAT_MTK_T61P
DEFINES += -DUFBL_PLAT_MTK_T61P -DUFBL_FASTBOOT_RESPONSE

# for specific changes per project
DEFINES += -DUFBL_PROJ_MTK_T61P
ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DUFBL_PROJ_abc123
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DUFBL_PROJ_abc123
else ifeq ($(TARGET_PRODUCT), queena)
DEFINES += -DUFBL_PROJ_QUNEENA
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DUFBL_PROJ_abc123
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DUFBL_PROJ_abc123
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DUFBL_PROJ_abc123
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DUFBL_PROJ_abc123
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
else ifeq ($(TARGET_PRODUCT), abc123eu)
DEFINES += -DUFBL_PROJ_abc123EU
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
else ifeq ($(TARGET_PRODUCT), coyote)
DEFINES += -DUFBL_PROJ_COYOTE
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
else ifeq ($(TARGET_PRODUCT), coyoteeu)
DEFINES += -DUFBL_PROJ_COYOTEEU
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true

# For mt9026
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DUFBL_PROJ_abc123
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
else ifeq ($(TARGET_PRODUCT), abc123eu)
DEFINES += -DUFBL_PROJ_abc123EU
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DUFBL_PROJ_abc123
FEATURE_REPLAY_PROTECTED_UNLOCK := true
FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG := true
endif

DEFINES += -DUFBL_PLATFORM_MSTAR
DEFINES += -DCONFIG_IDME_PARTITION_NUM=2
DEFINES += -DUFBL_FEATURE_IDME
ifeq ($(FEATURE_REPLAY_PROTECTED_UNLOCK),true)
DEFINES += -DIDME_NUM_OF_EMMC_BLOCKS=520
else
DEFINES += -DIDME_NUM_OF_EMMC_BLOCKS=512
endif
# IDME is some blocks from partition end
# IDME_BLOCK_OFFSET_FROM_END can't be smaller than IDME_NUM_OF_EMMC_BLOCKS
DEFINES += -DIDME_BLOCK_OFFSET_FROM_END=1024
DEFINES += -DUFBL_FEATURE_FOS_FLAGS

ifeq ($(FEATURE_SECURE_BOOT),true)
FEATURE_COMMON_OPENSSL := false
FEATURE_LIBTOMCRYPT := true
FEATURE_LIBTOMMATH := true
DEFINES += -DUFBL_FEATURE_SECURE_BOOT=1
DEFINES += -DBOARD_AMAZON_KERNEL_SIGNING
else ifeq ($(FEATURE_UNLOCK), true)
FEATURE_COMMON_OPENSSL := false
FEATURE_LIBTOMCRYPT := true
FEATURE_LIBTOMMATH := true
else
FEATURE_COMMON_OPENSSL := false
FEATURE_LIBTOMCRYPT := false
FEATURE_LIBTOMMATH := false
endif
ifeq ($(FEATURE_LIBTOMCRYPT),true)
DEFINES += -DMSTAR_SHA256_QUIRK
endif

ifeq ($(FEATURE_UNLOCK),true)
DEFINES += -DUFBL_FEATURE_UNLOCK
endif

ifeq ($(FEATURE_SECURE_FLASHING),true)
DEFINES += -DUFBL_FEATURE_SECURE_FLASHING
endif

ifeq ($(FEATURE_ONETIME_UNLOCK),true)
DEFINES += -DUFBL_FEATURE_ONETIME_UNLOCK
endif

ifeq ($(FEATURE_REPLAY_PROTECTED_UNLOCK),true)
DEFINES += -DUFBL_FEATURE_REPLAY_PROTECTED_UNLOCK
endif

ifeq ($(FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG),true)
DEFINES += -DUFBL_FEATURE_YUBIKEY_UNLOCK_PUB_KEY_TAG
# Since Yubikey tag is so important and it can only be provisioned once.
# So define them as macro and collect all values here together for Diag
# team to get correct values easily.
ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_LP=\"abc123-lp\"
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_GP=\"abc123-gp\"
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_WP=\"abc123-wp\"
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_GM=\"abc123-gm\"
else ifeq ($(TARGET_PRODUCT), abc123eu)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123EU_GM=\"abc123eu-gm\"
else ifeq ($(TARGET_PRODUCT), coyote)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_COYOTE_CH=\"coyote-ch\"
else ifeq ($(TARGET_PRODUCT), coyoteeu)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_COYOTEEU_PV=\"coyoteeu-pv\"

# For mt9026
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_GM=\"abc123-gm\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_DT=\"abc123-dt\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_OH=\"abc123-oh\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_GA=\"abc123-ga\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_HH=\"abc123-hh\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_HB_H=\"abc123-hb-h\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_HB_B=\"abc123-hb-b\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_HB_T=\"abc123-hb-t\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_HB_M=\"abc123-hb-m\"
else ifeq ($(TARGET_PRODUCT), abc123eu)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123EU_GM=\"abc123eu-gm\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123EU_SP=\"abc123eu-sp\"
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123EU_MT=\"abc123eu-mt\"
else ifeq ($(TARGET_PRODUCT), abc123)
DEFINES += -DYUBIKEY_PUB_KEY_TAG_abc123_FF=\"abc123-ff\"
endif
endif

DEFINES += -DIDME_UPDATE_TABLE=1

#export UFBL_DEFINES := $(addprefix -D,$(DEFINES))
export UFBL_DEFINES := $(DEFINES)
export FEATURE_LIBTOMCRYPT FEATURE_LIBTOMMATH FEATURE_SECURE_BOOT

UFBL_PROJ_MTK_T61P=yes
export UFBL_PROJ_MTK_T61P

# Use kbuild to build UFBL features
KBUILD_CFLAGS += $(DEFINES)
UFBL_UBOOT_IS_KBUILD := yes
export UFBL_UBOOT_IS_KBUILD

# After defining list of features, include
# ufbl common definitions
include $(LOCAL_DIR)/ufbl_common_uboot.mk
