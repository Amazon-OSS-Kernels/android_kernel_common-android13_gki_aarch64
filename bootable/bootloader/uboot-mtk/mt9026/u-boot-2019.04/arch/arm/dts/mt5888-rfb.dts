//	clock-frequency = <100000>;
//
//	start-count = <73>;         /* SCL and SDA count for start */
//	sda-count = <5>;            /* closk count between falling edge SCL and SDA */
//	data-latch-count = <5>;     /* data latch timing */
//	stop-count = <73>;          /* SCL and SDA count for stop */
//
//	status = "okay";
//};

&i2c1 {
	pad-mode = <1>;
	clock-frequency = <100000>;

	start-count = <73>;         /* SCL and SDA count for start */
	sda-count = <5>;            /* closk count between falling edge SCL and SDA */
	data-latch-count = <5>;     /* data latch timing */
	stop-count = <73>;          /* SCL and SDA count for stop */

	status = "okay";
};

