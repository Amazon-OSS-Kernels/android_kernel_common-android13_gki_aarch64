/{

	video_out:video_out {
		compatible = "mtk,mt5896-panel";
		status = "okay";
	#address-cells = <2>;
	#size-cells = <2>;
		gpio_backlight = <&gpio0 9 1>;
		gpio_vcc = <&gpio0 69 1>;
		panel_info_name_list = "panel_info", "panel_info_lvds_1920x1080_50",
		"panel_info_lvds_1920x1080_48";
		panel_info {
			panel_name = "FHD60_PANEL_2LANE";
			link_type = <2>;
			vbo_byte_mode = <4>;
			div_section = <1>;
			on_timing1 = <30>;
			on_timing2 = <200>;
			off_timing1 = <220>;
			off_timing2 = <10>;
			hsync_start = <0>;
			hsync_width = <30>;
			hsync_polarity = <1>;
			vsync_start = <0>;
			vsync_width = <2>;
			vsync_polarity = <1>;
			de_hstart = <110>;
			de_vstart = <98>;
			resolution_width = <1920>;
			resolution_height = <1080>;
			max_h_total = <2300>;
			typ_h_total = <2200>;
			min_h_total = <2100>;
			max_v_total = <1418>;
			typ_v_total = <1125>;
			min_v_total = <1078>;
			max_clk = <160000000>;
			typ_clk = <148500000>;
			min_clk = <140000000>;
			output_format = <0>;
			content_output_format = <0>;
			vrr_en = <0>;
			min_vrr_framerate = <30>;
			max_vrr_framerate = <120>;
			graphic_mixer1_outmode = <0>;
			graphic_mixer2_outmode = <1>;
		};
		panel_info_lvds_1920x1080_50 {
			panel_name = "FHD50_PANEL_2LANE";
			link_type = <2>;
			vbo_byte_mode = <4>;
			div_section = <1>;
			on_timing1 = <30>;
			on_timing2 = <200>;
			off_timing1 = <220>;
			off_timing2 = <10>;
			hsync_start = <0>;
			hsync_width = <30>;
			hsync_polarity = <1>;
			vsync_start = <0>;
			vsync_width = <2>;
			vsync_polarity = <1>;
			de_hstart = <110>;
			de_vstart = <98>;
			resolution_width = <1920>;
			resolution_height = <1080>;
			max_h_total = <2300>;
			typ_h_total = <2200>;
			min_h_total = <2100>;
			max_v_total = <1418>;
			typ_v_total = <1350>;
			min_v_total = <1078>;
			max_clk = <160000000>;
			typ_clk = <148500000>;
			min_clk = <140000000>;
			output_format = <0>;
			content_output_format = <0>;
			vrr_en = <0>;
			min_vrr_framerate = <30>;
			max_vrr_framerate = <120>;
			graphic_mixer1_outmode = <0>;
			graphic_mixer2_outmode = <1>;
		};
panel_info_lvds_1920x1080_48 {
			panel_name = "FHD48_PANEL_2LANE";
			link_type = <2>;
			vbo_byte_mode = <4>;
			div_section = <1>;
			on_timing1 = <30>;
			on_timing2 = <200>;
			off_timing1 = <220>;
			off_timing2 = <10>;
			hsync_start = <0>;
			hsync_width = <30>;
			hsync_polarity = <1>;
			vsync_start = <0>;
			vsync_width = <2>;
			vsync_polarity = <1>;
			de_hstart = <110>;
			de_vstart = <98>;
			resolution_width = <1920>;
			resolution_height = <1080>;
			max_h_total = <2300>;
			typ_h_total = <2200>;
			min_h_total = <2100>;
