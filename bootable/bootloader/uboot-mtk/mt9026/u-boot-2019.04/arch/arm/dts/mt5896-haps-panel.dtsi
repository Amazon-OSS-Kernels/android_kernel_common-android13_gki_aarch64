	graphic_out:graphic_out {
			compatible = "mtk,mt5896-gfx-panel";
			status = "disable";
	panel_info_name_list = "timing_info";
	timing_info {
				panel_name = "GFX output";
				link_type = <1>;
				vbo_byte_mode = <5>;
				div_section = <1>;
				on_timing1 = <30>;
