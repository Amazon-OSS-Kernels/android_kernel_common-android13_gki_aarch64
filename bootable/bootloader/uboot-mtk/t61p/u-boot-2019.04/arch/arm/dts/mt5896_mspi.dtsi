					// reg_sw_en_smi2mcu_mspi3
					0x1c2054f4 0x0001 0x0001
					// reg_sw_en_xtal_12m2mcu_mspi3
					0x1c205540 0x0100 0x0100
					// reg_sw_en_mcu_nonpm2mcu_mspi_all
					0x1c207b78 0x2000 0x2000
					// reg_sw_en_mspi32mcu_mspi3
					0x1c207bec 0xffff 0x0001
					// reg_sw_en_mspi3_div2mcu_ckctrl_top
					0x1c207c18 0xffff 0x0001
					// reg_ckg_mspi3_mheg5
					0x1c207270 0x0300 0x0000
					>;

		/* Format for module clock mux setting:
		 * Each clock mux setting have 7 <u32> values:
		 *     clock speed in Hz
		 *     register address of clock mux #1
