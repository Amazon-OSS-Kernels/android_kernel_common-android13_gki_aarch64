/ {
	aliases {
		spi0 = &mspi0;
		spi1 = &mspi1;
		spi2 = &mspi2;
		spi3 = &mspi3;
		spi4 = &mspi4;
		spi5 = &mspi5;
		spi6 = &mspi6;
		spi7 = &mspi7;
		spi8 = &mspi_ci;
		spi9 = &frc_mspi0;
	};

	mspi0: mspi@1c640800 {
		compatible = "mediatek,mt5896-spi";
		#address-cells = <2>;
		#size-cells = <2>;
		interrupt-parent = <&mtk_intc2_irq_low>;
		interrupts = <0x0 0x5 0x4>;
		mspi_channel = <0>;
		reg = <0 0x1c640800 0 0x200>;

		tr_mux = <8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8
			  8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8>;	// bits per word for all data words
		xfer_interval = <0>;	// The clk ticks delay between byte to byte transfer
		xfer_turn_d = <0>;	// The clk ticks delay between last write and first read
		xfer_trig_d = <0>;	// The clk ticks delay from "reg_mspi_trigger" to first SPI clock
		xfer_done_d = <0>;	// The clk ticks delay from last SPI clock to "reg_mspi_done_flag"

		module-clock-divider = <0x1c600f40>;	// clock divider register and mask
		module-clock-divider-mask = <0xf>;

		module-clocks-enable = <// 5 sw_en and 1 clk mux need to be enabled
					6
					// reg_sw_en_smi2mcu_mspi0
					0x1c2054f0 0x2000 0x2000
					// reg_sw_en_xtal_12m2mcu_mspi0
					0x1c205540 0x0020 0x0020
					// reg_sw_en_mcu_nonpm2mcu_mspi_all
					0x1c207b78 0x2000 0x2000
					// reg_sw_en_mspi02mcu_mspi0
					0x1c207c14 0xffff 0x0001
					// reg_sw_en_mspi0_div2mcu_ckctrl_top
					0x1c207c08 0xffff 0x0001
					// reg_ckg_mspi0_mheg5
					0x1c207240 0x0300 0x0000
					>;

		/* Format for module clock mux setting:
		 * Each clock mux setting have 7 <u32> values:
		 *     clock speed in Hz
		 *     register address of clock mux #1
		 *     register mask of clock mux #1
		 *     register value of clock mux #1
		 *     register address of clock mux #2
		 *     register mask of clock mux #2
		 *     register value of clock mux #2
		 */
		module-clock-select = <// reg_ckg_mspi7, reg_ckg_mspi7_div
				      172000000 0x1c207240 0x0007 0x0004 0x1c207248 0x001f 0x0000
				      123000000 0x1c207240 0x0007 0x0004 0x1c207248 0x001f 0x0004
				      108000000 0x1c207240 0x0007 0x0004 0x1c207248 0x001f 0x0008
				       86000000 0x1c207240 0x0007 0x0004 0x1c207248 0x001f 0x000c
				       72000000 0x1c207240 0x0007 0x0004 0x1c207248 0x001f 0x0010
				       62000000 0x1c207240 0x0007 0x0004 0x1c207248 0x001f 0x0014
				       48000000 0x1c207240 0x0007 0x0004 0x1c207248 0x001f 0x0018
				       30000000 0x1c207240 0x0007 0x0004 0x1c207248 0x001f 0x001c
				       24000000 0x1c207240 0x0007 0x0000 0x1c207248 0x001f 0x0000
				      >;

		clock-frequency = <24000000>;
		status = "okay";
	};

	mspi1: mspi@1c640a00 {
		compatible = "mediatek,mt5896-spi";
		#address-cells = <2>;
		#size-cells = <2>;
		interrupt-parent = <&mtk_intc2_irq_low>;
		interrupts = <0x0 0x6 0x4>;
		mspi_channel = <1>;
		reg = <0 0x1c640a00 0 0x200>;

		tr_mux = <8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8
			  8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8>;	// bits per word for all data words
		xfer_interval = <0>;	// The clk ticks delay between byte to byte transfer
		xfer_turn_d = <0>;	// The clk ticks delay between last write and first read
		xfer_trig_d = <0>;	// The clk ticks delay from "reg_mspi_trigger" to first SPI clock
		xfer_done_d = <0>;	// The clk ticks delay from last SPI clock to "reg_mspi_done_flag"

		module-clock-divider = <0x1c600f40>;	// clock divider register and mask
		module-clock-divider-mask = <0xf0>;

		module-clocks-enable = <// 5 sw_en and 1 clk mux need to be enabled
					6
					// reg_sw_en_smi2mcu_mspi1
					0x1c2054f0 0x4000 0x4000
					// reg_sw_en_xtal_12m2mcu_mspi1
					0x1c205540 0x0040 0x0040
					// reg_sw_en_mcu_nonpm2mcu_mspi_all
					0x1c207b78 0x2000 0x2000
					// reg_sw_en_mspi12mcu_mspi1
					0x1c207be4 0xffff 0x0001
					// reg_sw_en_mspi1_div2mcu_ckctrl_top
					0x1c207c0c 0xffff 0x0001
					// reg_ckg_mspi1_mheg5
					0x1c207250 0x0300 0x0000
					>;

		/* Format for module clock mux setting:
		 * Each clock mux setting have 7 <u32> values:
		 *     clock speed in Hz
		 *     register address of clock mux #1
		 *     register mask of clock mux #1
		 *     register value of clock mux #1
		 *     register address of clock mux #2
		 *     register mask of clock mux #2
		 *     register value of clock mux #2
		 */
		module-clock-select = <// reg_ckg_mspi7, reg_ckg_mspi7_div
				      172000000 0x1c207250 0x0007 0x0004 0x1c207258 0x001f 0x0000
				      123000000 0x1c207250 0x0007 0x0004 0x1c207258 0x001f 0x0004
				      108000000 0x1c207250 0x0007 0x0004 0x1c207258 0x001f 0x0008
				       86000000 0x1c207250 0x0007 0x0004 0x1c207258 0x001f 0x000c
				       72000000 0x1c207250 0x0007 0x0004 0x1c207258 0x001f 0x0010
				       62000000 0x1c207250 0x0007 0x0004 0x1c207258 0x001f 0x0014
				       48000000 0x1c207250 0x0007 0x0004 0x1c207258 0x001f 0x0018
				       30000000 0x1c207250 0x0007 0x0004 0x1c207258 0x001f 0x001c
				       24000000 0x1c207250 0x0007 0x0000 0x1c207258 0x001f 0x0000
				      >;

		clock-frequency = <24000000>;
		status = "okay";
	};

	mspi2: mspi@1c640c00 {
		compatible = "mediatek,mt5896-spi";
		#address-cells = <2>;
		#size-cells = <2>;
		interrupt-parent = <&mtk_intc2_irq_low>;
		interrupts = <0x0 0x7 0x4>;
		mspi_channel = <2>;
		reg = <0 0x1c640c00 0 0x200>;

		tr_mux = <8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8
			  8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8>;	// bits per word for all data words
		xfer_interval = <0>;	// The clk ticks delay between byte to byte transfer
		xfer_turn_d = <0>;	// The clk ticks delay between last write and first read
		xfer_trig_d = <0>;	// The clk ticks delay from "reg_mspi_trigger" to first SPI clock
		xfer_done_d = <0>;	// The clk ticks delay from last SPI clock to "reg_mspi_done_flag"

		module-clock-divider = <0x1c600f41>;	// clock divider register and mask
		module-clock-divider-mask = <0xf>;

		module-clocks-enable = <// 5 sw_en and 1 clk mux need to be enabled
					6
					// reg_sw_en_smi2mcu_mspi2
					0x1c2054f0 0x8000 0x8000
					// reg_sw_en_xtal_12m2mcu_mspi2
					0x1c205540 0x0080 0x0080
					// reg_sw_en_mcu_nonpm2mcu_mspi_all
					0x1c207b78 0x2000 0x2000
					// reg_sw_en_mspi22mcu_mspi2
					0x1c207be8 0xffff 0x0001
					// reg_sw_en_mspi2_div2mcu_ckctrl_top
					0x1c207c10 0xffff 0x0001
					// reg_ckg_mspi2_mheg5
					0x1c207260 0x0300 0x0000
					>;

		/* Format for module clock mux setting:
		 * Each clock mux setting have 7 <u32> values:
		 *     clock speed in Hz
		 *     register address of clock mux #1
		 *     register mask of clock mux #1
		 *     register value of clock mux #1
		 *     register address of clock mux #2
		 *     register mask of clock mux #2
		 *     register value of clock mux #2
		 */
		module-clock-select = <// reg_ckg_mspi7, reg_ckg_mspi7_div
				      172000000 0x1c207260 0x0007 0x0004 0x1c207268 0x001f 0x0000
				      123000000 0x1c207260 0x0007 0x0004 0x1c207268 0x001f 0x0004
				      108000000 0x1c207260 0x0007 0x0004 0x1c207268 0x001f 0x0008
				       86000000 0x1c207260 0x0007 0x0004 0x1c207268 0x001f 0x000c
				       72000000 0x1c207260 0x0007 0x0004 0x1c207268 0x001f 0x0010
				       62000000 0x1c207260 0x0007 0x0004 0x1c207268 0x001f 0x0014
				       48000000 0x1c207260 0x0007 0x0004 0x1c207268 0x001f 0x0018
				       30000000 0x1c207260 0x0007 0x0004 0x1c207268 0x001f 0x001c
				       24000000 0x1c207260 0x0007 0x0000 0x1c207268 0x001f 0x0000
				      >;

		clock-frequency = <24000000>;
		status = "okay";
	};

	mspi3: mspi@1c640e00 {
