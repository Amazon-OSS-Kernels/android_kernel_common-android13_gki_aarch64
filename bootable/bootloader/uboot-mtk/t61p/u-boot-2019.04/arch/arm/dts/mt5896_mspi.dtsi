					// reg_sw_en_smi2mcu_mspi7
					0x1c2054f4 0x0010 0x0010
					// reg_sw_en_xtal_12m2mcu_mspi7
					0x1c205540 0x1000 0x1000
					// reg_sw_en_mcu_nonpm2mcu_mspi_all
					0x1c207b78 0x2000 0x2000
					// reg_sw_en_mspi72mcu_mspi7
					0x1c207bfc 0xffff 0x0001
					// reg_sw_en_mspi7_div2mcu_ckctrl_top
					0x1c207c28 0xffff 0x0001
					// reg_ckg_mspi7_mheg5
					0x1c2072b0 0x0300 0x0000
					>;

		/* Format for module clock mux setting:
		 * Each clock mux setting have 7 <u32> values:
		 *     clock speed in Hz
		 *     register address of clock mux #1
		 *     register mask of clock mux #1
		 *     register value of clock mux #1
		 *     register address of clock mux #2
		 *     register mask of clock mux #2
		 *     register value of clock mux #2
		 */
		module-clock-select = <// reg_ckg_mspi7, reg_ckg_mspi7_div
				      172000000 0x1c2072b0 0x0007 0x0004 0x1c2072b8 0x001f 0x0000
				      123000000 0x1c2072b0 0x0007 0x0004 0x1c2072b8 0x001f 0x0004
				      108000000 0x1c2072b0 0x0007 0x0004 0x1c2072b8 0x001f 0x0008
				       86000000 0x1c2072b0 0x0007 0x0004 0x1c2072b8 0x001f 0x000c
				       72000000 0x1c2072b0 0x0007 0x0004 0x1c2072b8 0x001f 0x0010
				       62000000 0x1c2072b0 0x0007 0x0004 0x1c2072b8 0x001f 0x0014
				       48000000 0x1c2072b0 0x0007 0x0004 0x1c2072b8 0x001f 0x0018
				       30000000 0x1c2072b0 0x0007 0x0004 0x1c2072b8 0x001f 0x001c
				       24000000 0x1c2072b0 0x0007 0x0000 0x1c2072b8 0x001f 0x0000
				      >;

		clock-frequency = <24000000>;
		status = "okay";
	};

	mspi_ci: mspi@1c641A00 {
		compatible = "mediatek,mt5896-spi";
		#address-cells = <2>;
		#size-cells = <2>;
		interrupt-parent = <&mtk_intc2_irq_low>;
		interrupts = <0x0 0xd 0x4>;
		mspi_channel = <8>;
		reg = <0 0x1c641A00 0 0x200>,<0 0x1c206000 0 0x2000>;

		tr_mux = <8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8
			  8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8>;	// bits per word for all data words
		xfer_interval = <0>;	// The clk ticks delay between byte to byte transfer
		xfer_turn_d = <0>;	// The clk ticks delay between last write and first read
		xfer_trig_d = <0>;	// The clk ticks delay from "reg_mspi_trigger" to first SPI clock
		xfer_done_d = <0>;	// The clk ticks delay from last SPI clock to "reg_mspi_done_flag"

		module-clock-divider = <0x1c600f48>;	// clock divider register and mask
		module-clock-divider-mask = <0xf>;

		module-clocks-enable = <// 5 sw_en and 1 clk mux need to be enabled
					6
					// reg_sw_en_smi2mcu_mspi_cilink
					0x1c2054f4 0x0020 0x0020
					// reg_sw_en_xtal_12m2mcu_mspi_cilink
					0x1c205540 0x2000 0x2000
					// reg_sw_en_mcu_nonpm2mcu_mspi_all
					0x1c207b78 0x2000 0x2000
					// reg_sw_en_mspi_cilink_div2mcu_ckctrl_top
					0x1c207c00 0xffff 0x0001
					// reg_sw_en_mspi_cilink2mcu_mspi_cilink
					0x1c207c04 0xffff 0x0001
					// reg_ckg_mspi_cilink_mheg5
					0x1c207230 0x0300 0x0000
					>;

		/* Format for module clock mux setting:
		 * Each clock mux setting have 7 <u32> values:
		 *     clock speed in Hz
		 *     register address of clock mux #1
		 *     register mask of clock mux #1
		 *     register value of clock mux #1
		 *     register address of clock mux #2
		 *     register mask of clock mux #2
		 *     register value of clock mux #2
		 */
		module-clock-select = <// reg_ckg_mspi_cilink, reg_ckg_mspi_cilink_div
				      172000000 0x1c207230 0x0007 0x0004 0x1c207238 0x001f 0x0000
				      123000000 0x1c207230 0x0007 0x0004 0x1c207238 0x001f 0x0004
				      108000000 0x1c207230 0x0007 0x0004 0x1c207238 0x001f 0x0008
				       86000000 0x1c207230 0x0007 0x0004 0x1c207238 0x001f 0x000c
				       72000000 0x1c207230 0x0007 0x0004 0x1c207238 0x001f 0x0010
				       62000000 0x1c207230 0x0007 0x0004 0x1c207238 0x001f 0x0014
				       48000000 0x1c207230 0x0007 0x0004 0x1c207238 0x001f 0x0018
				       30000000 0x1c207230 0x0007 0x0004 0x1c207238 0x001f 0x001c
				       24000000 0x1c207230 0x0007 0x0000 0x1c207238 0x001f 0x0000
				      >;

		clock-frequency = <54000000>;
		status = "okay";
	};

	frc_mspi0: mspi@1d004a00 {
		compatible = "mediatek,mt5896-spi";
		#address-cells = <2>;
		#size-cells = <2>;
		interrupt-parent = <&mtk_intc2_irq_low>;
		interrupts = <0x0 0xe 0x4>;
		mspi_channel = <9>;
		reg = <0 0x1d004a00 0 0x200>,<0 0x1c206000 0 0x2000>;

		tr_mux = <8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8
			  8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8>;	// bits per word for all data words
		xfer_interval = <0>;	// The clk ticks delay between byte to byte transfer
		xfer_turn_d = <0>;	// The clk ticks delay between last write and first read
		xfer_trig_d = <0>;	// The clk ticks delay from "reg_mspi_trigger" to first SPI clock
		xfer_done_d = <0>;	// The clk ticks delay from last SPI clock to "reg_mspi_done_flag"

		module-clock-divider = <0x1c600f50>;	// clock divider register and mask
		module-clock-divider-mask = <0xf>;

		module-clocks-enable = <// 2 sw_en and 1 clk mux need to be enabled
					3
					// reg_sw_en_frc_mspi0_div2mcu_ckctrl_top
					0x1c207adc 0xffff 1
					// reg_sw_en_frc_mspi02frciopm, reg_sw_en_frc_mspi02frciopmrv55
					0x1c207ae0 0xffff 0x0003
					// reg_ckg_frc_mspi0_frciopmrv55
					0x1c2072c8 0xffff 0x0000
					>;

		/* Format for module clock mux setting:
		 * Each clock mux setting have 7 <u32> values:
		 *     clock speed in Hz
		 *     register address of clock mux #1
		 *     register mask of clock mux #1
		 *     register value of clock mux #1
		 *     register address of clock mux #2
		 *     register mask of clock mux #2
		 *     register value of clock mux #2
		 */
		module-clock-select = <// reg_ckg_frc_mspi0, reg_ckg_frc_mspi0_div
				      172000000 0x1c2072c0 0xffff 0x0004 0x1c2072d0 0xffff 0x0000
				      123000000 0x1c2072c0 0xffff 0x0004 0x1c2072d0 0xffff 0x0004
				      108000000 0x1c2072c0 0xffff 0x0004 0x1c2072d0 0xffff 0x0008
				       86000000 0x1c2072c0 0xffff 0x0004 0x1c2072d0 0xffff 0x000c
				       72000000 0x1c2072c0 0xffff 0x0004 0x1c2072d0 0xffff 0x0010
				       62000000 0x1c2072c0 0xffff 0x0004 0x1c2072d0 0xffff 0x0014
				       48000000 0x1c2072c0 0xffff 0x0004 0x1c2072d0 0xffff 0x0018
				       30000000 0x1c2072c0 0xffff 0x0004 0x1c2072d0 0xffff 0x001c
				       24000000 0x1c2072c0 0xffff 0x0000 0x1c2072d0 0xffff 0x0000
				      >;

		clock-frequency = <24000000>;
		status = "okay";
	};

	frc_mspi: frc_mspi {
	};
};
