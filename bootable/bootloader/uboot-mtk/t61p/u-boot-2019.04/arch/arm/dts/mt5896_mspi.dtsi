		 *     register value of clock mux #1
		 *     register address of clock mux #2
		 *     register mask of clock mux #2
		 *     register value of clock mux #2
		 */
		module-clock-select = <// reg_ckg_mspi7, reg_ckg_mspi7_div
				      172000000 0x1c207270 0x0007 0x0004 0x1c207278 0x001f 0x0000
				      123000000 0x1c207270 0x0007 0x0004 0x1c207278 0x001f 0x0004
				      108000000 0x1c207270 0x0007 0x0004 0x1c207278 0x001f 0x0008
				       86000000 0x1c207270 0x0007 0x0004 0x1c207278 0x001f 0x000c
				       72000000 0x1c207270 0x0007 0x0004 0x1c207278 0x001f 0x0010
				       62000000 0x1c207270 0x0007 0x0004 0x1c207278 0x001f 0x0014
				       48000000 0x1c207270 0x0007 0x0004 0x1c207278 0x001f 0x0018
				       30000000 0x1c207270 0x0007 0x0004 0x1c207278 0x001f 0x001c
				       24000000 0x1c207270 0x0007 0x0000 0x1c207278 0x001f 0x0000
				      >;

		clock-frequency = <24000000>;
