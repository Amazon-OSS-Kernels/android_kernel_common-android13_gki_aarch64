				      172000000 0x1c207280 0x0007 0x0004 0x1c207288 0x001f 0x0000
				      123000000 0x1c207280 0x0007 0x0004 0x1c207288 0x001f 0x0004
				      108000000 0x1c207280 0x0007 0x0004 0x1c207288 0x001f 0x0008
				       86000000 0x1c207280 0x0007 0x0004 0x1c207288 0x001f 0x000c
				       72000000 0x1c207280 0x0007 0x0004 0x1c207288 0x001f 0x0010
				       62000000 0x1c207280 0x0007 0x0004 0x1c207288 0x001f 0x0014
				       48000000 0x1c207280 0x0007 0x0004 0x1c207288 0x001f 0x0018
				       30000000 0x1c207280 0x0007 0x0004 0x1c207288 0x001f 0x001c
